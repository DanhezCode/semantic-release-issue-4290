{
  "type": "module",
  "scripts": {
    "build": "echo 'No build step required for this package.'",
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@opinionated-ts/config": "1.5.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "semantic-release": "^25.0.9"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0",
    "node": "^26.2.0"
  },
  "packageManager": "bun@1.4.0"
}
